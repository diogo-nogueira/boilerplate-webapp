# Copiar para .env e alterar. O .env nunca vai para o GitHub.
DJANGO_SECRET_KEY=trocar-por-uma-chave-gerada

# Base de dados. Sem DB_ENGINE usa-se SQLite (backend/db.sqlite3) e o resto é ignorado.
# Para usar PostgreSQL (por exemplo na cloud), tirar o # e preencher:
# DB_ENGINE=postgres
# DB_NAME=nome-da-base
# DB_USER=utilizador
# DB_PASSWORD=palavra-passe-da-base
# DB_HOST=servidor.exemplo.com
# DB_PORT=5432
# DB_SSLMODE=require
